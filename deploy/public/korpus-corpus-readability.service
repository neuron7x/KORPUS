[Unit]
Description=KORPUS: щохвилинна проба читаності обслуговуваного корпусу
After=korpus-public-api.service

[Service]
Type=oneshot
WorkingDirectory=@KORPUS_ROOT@
Environment=PYTHONPATH=@KORPUS_ROOT@/apps/api/src:@KORPUS_ROOT@/scripts
ExecStart="@KORPUS_ROOT@/apps/api/.venv/bin/python" scripts/watch_corpus_readability.py --database var/runtime/corpus-v6-20260807/korpus.db --out var/corpus-readability.json
TimeoutStartSec=60
NoNewPrivileges=true
# Проба, що сама стала джерелом тиску, стерегла б власну причину. 256 МБ — на порядок
# більше за її вимір (два константні запити) і на порядок менше за все, що тут падало:
# мутант нічного лану брав 4,2 ГБ, поки йому не поставили межу.
MemoryMax=256M
