[Unit]
Description=KORPUS loopback public API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@KORPUS_ROOT@
# Оточення береться з ОДНОГО джерела — файла, який `scripts/serve_public.sh` пише як
# проєкцію власного оточення. Тут стояло п'ятнадцять рядків `Environment=`, тобто друга
# копія тієї самої властивості, і вона розійшлася з першою саме там, де ніхто не дивився:
# сторож відновлює API через `systemctl --user restart`, а не через скрипт. Виміряно
# 31.08.2026 — після відновлення о 21:34 у живому процесі не було ні
# `KORPUS_MODEL_EGRESS_POSTURE`, ні ключа аудиту, тож посада лишалась `external_allowed`,
# а журнал підписувався плейсхолдером `replace-local-audit-key` із config.py.
#
# Без префікса `-` навмисно: немає файла — юніт НЕ стартує. Публічний API, що піднявся
# з вгаданим оточенням, гірший за той, що не піднявся зовсім.
EnvironmentFile=%h/.local/state/korpus-public/api.env
ExecStart="@KORPUS_ROOT@/apps/api/.venv/bin/python" -m uvicorn korpus.main:app --host 127.0.0.1 --port 8000 --log-level warning --workers 2
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
CPUAccounting=true
CPUQuota=250%
MemoryAccounting=true
MemoryHigh=2G
MemoryMax=3G
TasksMax=128
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
