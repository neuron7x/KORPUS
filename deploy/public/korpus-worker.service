[Unit]
Description=KORPUS durable ingestion worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@KORPUS_ROOT@
Environment=KORPUS_ENVIRONMENT=local
Environment=KORPUS_RUNTIME_ROLE=worker
Environment="KORPUS_DATABASE_URL=sqlite:///@KORPUS_ROOT@/var/runtime/corpus-v6-20260807/korpus.db"
Environment="KORPUS_OBJECT_ROOT=@KORPUS_ROOT@/var/runtime/corpus-v6-20260807/objects"
Environment="KORPUS_AUDIT_ANCHOR_PATH=@KORPUS_ROOT@/var/runtime/corpus-v6-20260807/audit.anchor"
Environment=KORPUS_AUTH_MODE=jwt
Environment=KORPUS_JWT_SECRET_FILE=%h/.local/state/korpus-public/jwt-secret.txt
Environment=KORPUS_JWT_ISSUER=korpus-public
Environment=KORPUS_JWT_AUDIENCE=korpus
Environment=KORPUS_JWT_MAX_LIFETIME_MINUTES=1440
Environment="PYTHONPATH=@KORPUS_ROOT@/apps/api/src"
ExecCondition="@KORPUS_ROOT@/apps/api/.venv/bin/python" "@KORPUS_ROOT@/scripts/audit_runtime_corpus.py" --database "@KORPUS_ROOT@/var/runtime/corpus-v6-20260807/korpus.db" --object-root "@KORPUS_ROOT@/var/runtime/corpus-v6-20260807/objects" --out "@KORPUS_ROOT@/var/public/runtime-corpus-audit-worker.json"
ExecStart="@KORPUS_ROOT@/apps/api/.venv/bin/python" -m korpus.cli worker-loop --idle-seconds 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
CPUAccounting=true
CPUQuota=250%
MemoryAccounting=true
MemoryHigh=3G
MemoryMax=5G
TasksMax=128
OOMPolicy=stop
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
