{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://korpus.local/contracts/document.v1.schema.json",
  "title": "KORPUS Document v1",
  "type": "object",
  "required": ["canonical_title", "corpus_id", "issuer", "jurisdiction", "document_type", "access_tier", "classification"],
  "properties": {
    "canonical_title": {"type": "string", "minLength": 3, "maxLength": 500},
    "corpus_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "issuer": {"type": "string", "minLength": 2},
    "jurisdiction": {"type": "string", "minLength": 2},
    "document_type": {"type": "string", "minLength": 2},
    "access_tier": {"type": "integer", "minimum": 0, "maximum": 3},
    "classification": {"enum": ["public", "internal", "restricted"]}
  }
}
