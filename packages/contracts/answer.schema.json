{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://korpus.local/contracts/answer.schema.json",
  "title": "EvidenceBoundAnswer",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "text", "citations", "confidence", "limitations"],
  "properties": {
    "status": {"enum": ["answered", "insufficient_evidence", "access_denied", "requires_human_review"]},
    "text": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "title", "quote"],
        "properties": {
          "document_id": {"type": "string", "format": "uuid"},
          "title": {"type": "string", "minLength": 1},
          "revision": {"type": ["string", "null"]},
          "page": {"type": ["integer", "null"], "minimum": 1},
          "section": {"type": ["string", "null"]},
          "quote": {"type": "string", "minLength": 1, "maxLength": 1200},
          "source_uri": {"type": ["string", "null"]}
        }
      }
    }
  }
}

