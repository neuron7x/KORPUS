KORPUS_ENVIRONMENT=local
KORPUS_DATABASE_URL=sqlite:///./var/korpus.db
KORPUS_OBJECT_ROOT=./var/objects
KORPUS_AUDIT_HMAC_KEY=replace-local-audit-key
KORPUS_AUTH_MODE=dev
KORPUS_JWT_SECRET=replace-local-jwt-secret
KORPUS_JWT_ISSUER=korpus-local
KORPUS_JWT_AUDIENCE=korpus-api
KORPUS_DEV_SUBJECT=local-admin
KORPUS_DEV_ROLES=admin,curator,reviewer,instructor,user,auditor
KORPUS_DEV_CLEARANCE=restricted
KORPUS_DEV_CORPORA=public,training,administrative,restricted-demo
KORPUS_MIN_RETRIEVAL_SCORE=0.18
KORPUS_MIN_QUERY_COVERAGE=0.25
KORPUS_OCR_ENABLED=true
KORPUS_OCR_LANGUAGES=ukr+eng
KORPUS_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
NEXT_PUBLIC_KORPUS_API_URL=http://127.0.0.1:8000
