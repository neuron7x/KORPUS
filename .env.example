# Local single-process mode. Docker Compose supplies PostgreSQL/S3 settings itself.
KORPUS_ENVIRONMENT=local
KORPUS_DATABASE_URL=sqlite:///./var/korpus.db
KORPUS_DATABASE_POOL_SIZE=8
KORPUS_DATABASE_MAX_OVERFLOW=8
KORPUS_DATABASE_POOL_TIMEOUT_SECONDS=10
KORPUS_DATABASE_POOL_RECYCLE_SECONDS=1800
KORPUS_DATABASE_CONNECT_TIMEOUT_SECONDS=5
KORPUS_DATABASE_STATEMENT_TIMEOUT_MS=30000
KORPUS_DATABASE_LOCK_TIMEOUT_MS=5000
KORPUS_SCHEMA_MODE=auto

KORPUS_OBJECT_STORE_MODE=local
KORPUS_OBJECT_ROOT=./var/objects
KORPUS_S3_BUCKET=
KORPUS_S3_PREFIX=objects
KORPUS_S3_ENDPOINT_URL=
KORPUS_S3_REGION=
KORPUS_S3_GOVERNANCE_RETENTION_DAYS=0
KORPUS_S3_FORCE_PATH_STYLE=false
KORPUS_S3_CONNECT_TIMEOUT_SECONDS=3
KORPUS_S3_READ_TIMEOUT_SECONDS=15
KORPUS_S3_MAX_ATTEMPTS=4

KORPUS_AUDIT_ANCHOR_MODE=file
KORPUS_AUDIT_ANCHOR_PATH=./var/audit-anchor.json
KORPUS_AUDIT_ANCHOR_URL=
KORPUS_AUDIT_ANCHOR_TOKEN=
KORPUS_AUDIT_HMAC_KEY=replace-local-audit-key
KORPUS_AUDIT_RECONCILE_INTERVAL_SECONDS=2
KORPUS_AUDIT_RECONCILE_BATCH_SIZE=64
KORPUS_AUDIT_MAX_PENDING_EVENTS=64
KORPUS_AUDIT_MAX_PENDING_AGE_SECONDS=30

KORPUS_AUTH_MODE=dev
KORPUS_JWT_SECRET=replace-local-jwt-secret
KORPUS_JWT_ISSUER=korpus-local
KORPUS_JWT_AUDIENCE=korpus-api
KORPUS_JWT_MAX_LIFETIME_MINUTES=120
KORPUS_OIDC_JWKS_URL=
KORPUS_OIDC_ALGORITHMS=RS256,ES256
KORPUS_OIDC_JWKS_CACHE_SECONDS=300
KORPUS_OIDC_HTTP_TIMEOUT_SECONDS=5
KORPUS_OIDC_CLOCK_SKEW_SECONDS=30
KORPUS_DEV_SUBJECT=local-admin
KORPUS_DEV_ROLES=admin,curator,reviewer,instructor,user,auditor
KORPUS_DEV_CLEARANCE=restricted
KORPUS_DEV_CORPORA=public,training,administrative,restricted-demo

# Commercial edge. Leave LiqPay keys empty until a merchant account exists. Client-server
# checkout keeps card details on LiqPay; KORPUS receives only signed callbacks.
KORPUS_SUBSCRIPTION_REQUIRED=false
KORPUS_FREE_CORPORA=
KORPUS_BILLING_WEBHOOK_SECRET=
KORPUS_LIQPAY_PUBLIC_KEY=
KORPUS_LIQPAY_PRIVATE_KEY=
KORPUS_LIQPAY_SIGNATURE_ALGORITHM=sha3_256
KORPUS_BILLING_PUBLIC_BASE_URL=
# Optional deployment-owned sellable plan. Price is integer minor units: 19900 = UAH 199.00.
KORPUS_BILLING_PLAN_CODE=
KORPUS_BILLING_PLAN_NAME=KORPUS
KORPUS_BILLING_PLAN_PRICE_MINOR=
KORPUS_BILLING_PLAN_CURRENCY=UAH
KORPUS_BILLING_PLAN_INTERVAL=monthly
KORPUS_BILLING_PLAN_CORPORA=

KORPUS_ANSWER_POLICY_MODE=development
KORPUS_CALIBRATION_PROFILE_PATH=
KORPUS_MIN_RETRIEVAL_SCORE=0.18
KORPUS_MIN_QUERY_COVERAGE=0.25
KORPUS_MIN_SUPPORT_SCORE=0.18
KORPUS_RETRIEVAL_CANDIDATE_BUDGET=256
KORPUS_RETRIEVAL_TIMEOUT_MS=1200
KORPUS_SEMANTIC_RETRIEVAL_ENABLED=false
KORPUS_SEMANTIC_WEIGHT=0.0
KORPUS_EMBEDDING_ENDPOINT=
KORPUS_EMBEDDING_MODEL_ID=
KORPUS_EMBEDDING_DIMENSIONS=768
KORPUS_EMBEDDING_TOKEN=
KORPUS_EMBEDDING_TIMEOUT_SECONDS=5
KORPUS_EMBEDDING_MAX_ATTEMPTS=3
KORPUS_EMBEDDING_MAX_RESPONSE_BYTES=2097152
KORPUS_RETRIEVAL_CACHE_ENTRIES=512
KORPUS_RETRIEVAL_CACHE_TTL_SECONDS=30

KORPUS_MAX_CONCURRENT_ANSWERS=16
KORPUS_MAX_CONCURRENT_INGESTIONS=2
KORPUS_ADMISSION_WAIT_MS=50
KORPUS_INGESTION_WAIT_MS=100
KORPUS_METRICS_ENABLED=true
KORPUS_METRICS_TOKEN=
KORPUS_OTLP_ENDPOINT=
KORPUS_SERVICE_NAME=korpus-api
KORPUS_REVIEW_SEPARATION_REQUIRED=false

KORPUS_MAX_UPLOAD_BYTES=52428800
KORPUS_MAX_PDF_PAGES=500
KORPUS_MAX_SPANS_PER_DOCUMENT=20000
KORPUS_MAX_CHUNK_CHARS=1400
KORPUS_CHUNK_OVERLAP_CHARS=180
KORPUS_OCR_ENABLED=true
KORPUS_OCR_LANGUAGES=ukr+eng
KORPUS_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
KORPUS_TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Backup/restore CLI only. Keep the key outside the repository in controlled deployments.
KORPUS_BACKUP_DATABASE_URL=
KORPUS_RESTORE_DATABASE_URL=
KORPUS_BACKUP_ENCRYPTION_KEY_FILE=./infra/secrets/backup_encryption_key.txt
KORPUS_BACKUP_KEY_ID=local-v1
KORPUS_BACKUP_DIR=./var/backups/postgres
KORPUS_BACKUP_RETENTION_DAYS=14
