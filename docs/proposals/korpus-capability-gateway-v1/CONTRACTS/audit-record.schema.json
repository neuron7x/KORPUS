{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:korpus:capability-gateway:v1:audit-record",
  "title": "KORPUS Capability AuditRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "invocation_id",
    "subject_ref",
    "capability",
    "policy_decision_ref",
    "input_digest",
    "outcome",
    "started_at",
    "ended_at",
    "service_release"
  ],
  "properties": {
    "schema_version": {
      "const": "korpus.capability-audit.v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "invocation_id": {
      "type": "string",
      "format": "uuid"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "adapter_id",
        "adapter_version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "adapter_id": {
          "type": "string"
        },
        "adapter_version": {
          "type": "string"
        }
      }
    },
    "policy_decision_ref": {
      "type": "string",
      "minLength": 1
    },
    "input_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "output_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evidence_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "idempotency_binding": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "provider_receipt_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "outcome": {
      "enum": [
        "SUCCESS",
        "DENIED",
        "REJECTED",
        "FAILED",
        "ABSTAINED",
        "OUTCOME_UNKNOWN"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "service_release": {
      "type": "string",
      "minLength": 1
    }
  }
}
